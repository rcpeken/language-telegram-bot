# ---------------------------------------------------------------
# LLM saglayicisi - hangisini kullanacaksan SADECE onun anahtarini doldur
# ---------------------------------------------------------------
# gemini | groq | openrouter -> ucretsiz
# anthropic                  -> ucretli
LINGO_PROVIDER=gemini

# Google AI Studio - ucretsiz, kredi karti istemiyor
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq - ucretsiz, kredi karti istemiyor
# https://console.groq.com/keys
# GROQ_API_KEY=

# OpenRouter - ":free" ekli modeller ucretsiz
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Anthropic Claude - ucretli
# https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Model adini bos birakirsan saglayicinin varsayilani kullanilir.
# Gecerli adlari gormek icin: python list_models.py
# LINGO_MODEL=

# ---------------------------------------------------------------
# Telegram - zorunlu
# ---------------------------------------------------------------
# @BotFather ile bot olustur, verdigi token'i buraya yapistir
TELEGRAM_BOT_TOKEN=
# Bota bir mesaj at, sonra: python get_chat_id.py
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------
# Diller ve seviye
# ---------------------------------------------------------------
# Virgulle ayir. Ispanyolcayi acmak icin: LINGO_LANGS=en,es
LINGO_LANGS=en

# CEFR araligi. Model kelimeleri bu araliktan secer.
# LINGO_EN_LEVEL=B2-C1
# LINGO_ES_LEVEL=A1-A2

# Telaffuz aksani (gTTS alan adi): co.uk = Ingiliz, com = Amerikan
# LINGO_EN_ACCENT=co.uk
# LINGO_ES_ACCENT=es

# ---------------------------------------------------------------
# Gunluk yuk
# ---------------------------------------------------------------
# Her calismada kac yeni kelime ve kac tekrar karti gonderilsin.
# Varsayilan 3+2 = mesaj basina 5 kart, gunde 5 calisma -> 15 yeni kelime.
# LINGO_NEW_PER_RUN=3
# LINGO_REVIEW_PER_RUN=2

# Kelime havuzu: tek LLM cagrisinda kac kelime uretilip saklansin.
# Varsayilan gunluk ihtiyac kadar (5 slot x 3 kelime = 15). Buyutmek
# gunluk cagri sayisini dusurur, kucultmek artirir.
# LINGO_POOL_TARGET=15

# ---------------------------------------------------------------
# Opsiyonel
# ---------------------------------------------------------------
# Sesli telaffuzu kapatmak icin 0
# LINGO_AUDIO=1
# Biliyorum/bilmiyorum dugmelerini kapatmak icin 0
# LINGO_BUTTONS=1
# Ayni slotta ikinci gonderimi engelleyen esik (saat)
# LINGO_MIN_GAP_HOURS=2
